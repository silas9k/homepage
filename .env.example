# Local-only by default. For direct LAN/Tailscale access, bind to the VM address.
HOMEPAGE_BIND=127.0.0.1
HOMEPAGE_PORT=3000
HOMEPAGE_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
TZ=Europe/Berlin

# Leave optional integrations empty. No credentials are required for initial startup.
# Use single quotes around values containing $, #, or spaces. Never commit .env.
# Service URLs must be real http(s) URLs without embedded passwords. SSH launchers use ssh://USER@HOST.
HOMEPAGE_TLS_INSECURE_HOSTS=
HOMEPAGE_VAR_PROXMOX_URL=
HOMEPAGE_VAR_PROXMOX_SSH_URL=
HOMEPAGE_VAR_PROXMOX_TOKEN_ID=
HOMEPAGE_VAR_PROXMOX_TOKEN_SECRET=
HOMEPAGE_VAR_PROXMOX_NODE=
HOMEPAGE_VAR_DEBIAN_URL=
HOMEPAGE_VAR_DEBIAN_SSH_URL=
HOMEPAGE_VAR_DEBIAN_LAN_IP=
HOMEPAGE_VAR_DEBIAN_TAILSCALE_IP=
HOMEPAGE_VAR_DEBIAN_SSH_USER=
HOMEPAGE_VAR_DEBIAN_HEALTH_URL=
HOMEPAGE_VAR_DEBIAN_GLANCES_URL=
HOMEPAGE_VAR_DEBIAN_GLANCES_USER=
HOMEPAGE_VAR_DEBIAN_GLANCES_PASSWORD=
HOMEPAGE_VAR_RASPI_URL=
HOMEPAGE_VAR_RASPI_SSH_URL=
HOMEPAGE_VAR_RASPI_LAN_IP=
HOMEPAGE_VAR_RASPI_TAILSCALE_IP=
HOMEPAGE_VAR_RASPI_SSH_USER=
HOMEPAGE_VAR_RASPI_HEALTH_URL=
HOMEPAGE_VAR_RASPI_GLANCES_URL=
HOMEPAGE_VAR_RASPI_GLANCES_USER=
HOMEPAGE_VAR_RASPI_GLANCES_PASSWORD=
HOMEPAGE_VAR_NEXTCLOUD_URL=
HOMEPAGE_VAR_NEXTCLOUD_HEALTH_URL=
HOMEPAGE_VAR_NEXTCLOUD_TOKEN=
HOMEPAGE_VAR_VAULTWARDEN_URL=
HOMEPAGE_VAR_VAULTWARDEN_HEALTH_URL=
HOMEPAGE_VAR_PAPERLESS_URL=
HOMEPAGE_VAR_PAPERLESS_TOKEN=
HOMEPAGE_VAR_JELLYFIN_URL=
HOMEPAGE_VAR_JELLYFIN_HEALTH_URL=
HOMEPAGE_VAR_JELLYFIN_TOKEN=
HOMEPAGE_VAR_JELLYFIN_WIDGET_VERSION=1
HOMEPAGE_VAR_HOMEASSISTANT_URL=
HOMEPAGE_VAR_HOMEASSISTANT_HEALTH_URL=
HOMEPAGE_VAR_HOMEASSISTANT_API_URL=
HOMEPAGE_VAR_HOMEASSISTANT_TOKEN=
HOMEPAGE_VAR_PORTAINER_URL=
HOMEPAGE_VAR_PORTAINER_HEALTH_URL=
HOMEPAGE_VAR_PORTAINER_ENV=
HOMEPAGE_VAR_PORTAINER_TOKEN=
HOMEPAGE_VAR_CLOUDFLARE_ACCOUNT_ID=
HOMEPAGE_VAR_CLOUDFLARE_TUNNEL_ID=
HOMEPAGE_VAR_CLOUDFLARE_TOKEN=
HOMEPAGE_VAR_TAILSCALE_DEVICE_ID=
HOMEPAGE_VAR_TAILSCALE_TOKEN=
HOMEPAGE_VAR_RESTICWATCH_URL=
HOMEPAGE_VAR_RESTICWATCH_HEALTH_URL=

# Two independent houses. A = ThinkCentre; B = Raspberry Pi (rename in settings.yaml).
HOMEPAGE_VAR_HOMEBRIDGE_A_URL=
HOMEPAGE_VAR_HOMEBRIDGE_A_HEALTH_URL=
HOMEPAGE_VAR_HOMEBRIDGE_A_API_URL=
HOMEPAGE_VAR_HOMEBRIDGE_A_USER=
HOMEPAGE_VAR_HOMEBRIDGE_A_PASSWORD=
HOMEPAGE_VAR_HOMEBRIDGE_B_URL=
HOMEPAGE_VAR_HOMEBRIDGE_B_HEALTH_URL=
HOMEPAGE_VAR_HOMEBRIDGE_B_API_URL=
HOMEPAGE_VAR_HOMEBRIDGE_B_USER=
HOMEPAGE_VAR_HOMEBRIDGE_B_PASSWORD=

# Keep URLs empty until services exist. Public hostname suggestions are in deploy/*/.env.example.
HOMEPAGE_VAR_MEMOS_URL=
HOMEPAGE_VAR_MEMOS_HEALTH_URL=
HOMEPAGE_VAR_PALMR_URL=
HOMEPAGE_VAR_PALMR_HEALTH_URL=
HOMEPAGE_VAR_IMMICH_URL=
HOMEPAGE_VAR_IMMICH_HEALTH_URL=
HOMEPAGE_VAR_CRAFTY_URL=
HOMEPAGE_VAR_CRAFTY_HEALTH_URL=
HOMEPAGE_VAR_BACKUP_HDD_URL=
HOMEPAGE_VAR_BACKUP_HDD_HEALTH_URL=
HOMEPAGE_VAR_IMMICH_API_URL=
HOMEPAGE_VAR_IMMICH_TOKEN=

# Minecraft native widget uses udp://DNS-NAME:25565 syntax; Java status is queried over TCP.
HOMEPAGE_VAR_MINECRAFT_URL=
HOMEPAGE_VAR_MINECRAFT_STATUS_URL=
HOMEPAGE_VAR_MINECRAFT_2_URL=
HOMEPAGE_VAR_MINECRAFT_2_STATUS_URL=
HOMEPAGE_VAR_PLAYIT_URL=
HOMEPAGE_VAR_PLAYIT_HEALTH_URL=
